<?xml version="1.0" encoding="utf-8"?>
<!--
  React Native Windows (New Architecture / WinAppSDK) native module for
  @padosoft/react-native-ecr17.

  Builds one DLL that:
    - provides the `NitroModules` TurboModule (react-native-nitro-modules has no
      Windows project) and installs Nitro into the JS runtime;
    - registers the `Ecr17Client` HybridObject (the shared C++ protocol core in ../../cpp)
      and the `Ecr17Transport` HybridObject (Winsock, HybridEcr17TransportWindows.cpp).

  Nitro's C++ runtime is compiled from the app's node_modules/react-native-nitro-modules.
  The nitrogen output (../../nitrogen/generated) must exist: it ships in the npm
  package, and in this repo it is generated with `cd package && npx nitrogen`.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(SolutionDir)\ExperimentalFeatures.props" Condition="Exists('$(SolutionDir)\ExperimentalFeatures.props')" />
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{D4D22C00-CCAE-4C1E-A797-1959953A927E}</ProjectGuid>
    <ProjectName>Ecr17</ProjectName>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Ecr17</RootNamespace>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <PropertyGroup Label="ReactNativeWindowsProps">
    <!-- Resolve from the consuming app's solution first, then from this package. -->
    <ReactNativeWindowsDir Condition="'$(ReactNativeWindowsDir)' == '' and '$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$([MSBuild]::GetDirectoryNameOfFileAbove($(SolutionDir), 'node_modules\react-native-windows\package.json'))\node_modules\react-native-windows\</ReactNativeWindowsDir>
    <ReactNativeWindowsDir Condition="'$(ReactNativeWindowsDir)' == '' or !Exists('$(ReactNativeWindowsDir)package.json')">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'node_modules\react-native-windows\package.json'))\node_modules\react-native-windows\</ReactNativeWindowsDir>
    <NitroModulesDir Condition="'$(NitroModulesDir)' == '' and '$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$([MSBuild]::GetDirectoryNameOfFileAbove($(SolutionDir), 'node_modules\react-native-nitro-modules\package.json'))\node_modules\react-native-nitro-modules\</NitroModulesDir>
    <NitroModulesDir Condition="'$(NitroModulesDir)' == '' or !Exists('$(NitroModulesDir)package.json')">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'node_modules\react-native-nitro-modules\package.json'))\node_modules\react-native-nitro-modules\</NitroModulesDir>
    <!-- The package root (holds cpp/, nitrogen/, scripts/). -->
    <Ecr17PackageDir Condition="'$(Ecr17PackageDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</Ecr17PackageDir>
    <Ecr17GeneratedDir>$(Ecr17PackageDir)nitrogen\generated\shared\c++\</Ecr17GeneratedDir>
    <RunAutolinkCheck>false</RunAutolinkCheck>
    <RunCodegenWindows>false</RunCodegenWindows>
  </PropertyGroup>
  <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.WindowsSdk.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <GenerateManifest>false</GenerateManifest>
    <!-- After Cpp.Default.props. An empty/v100 toolset means VS 2010; pick the installed MSVC instead. -->
    <PlatformToolset Condition="'$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100'">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0' and ('$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100')">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '17.0' and ('$(PlatformToolset)' == '' or '$(PlatformToolset)' == 'v100')">v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="ReactNativeWindowsPropertySheets">
    <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props" Condition="Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props')" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ForcedIncludeFiles>NitroMsvcStdCompat.h</ForcedIncludeFiles>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /Zc:__cplusplus</AdditionalOptions>
      <DisableSpecificWarnings>4100;4244;4267;4453;28204</DisableSpecificWarnings>
      <PreprocessorDefinitions>_WINRT_DLL;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalUsingDirectories>$(WindowsSDK_WindowsMetadata);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory);
        $(MSBuildThisFileDirectory)..\include;
        $(Ecr17PackageDir)cpp;
        $(Ecr17PackageDir)cpp\Ecr17Client;
        $(Ecr17GeneratedDir);
        $(NitroModulesDir)cpp\core;
        $(NitroModulesDir)cpp\entrypoint;
        $(NitroModulesDir)cpp\jsi;
        $(NitroModulesDir)cpp\platform;
        $(NitroModulesDir)cpp\prototype;
        $(NitroModulesDir)cpp\registry;
        $(NitroModulesDir)cpp\templates;
        $(NitroModulesDir)cpp\threading;
        $(NitroModulesDir)cpp\utils;
        $(NitroModulesDir)cpp\views;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>ws2_32.lib;shell32.lib;user32.lib;windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <ModuleDefinitionFile>Ecr17.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemGroup>
    <ClInclude Include="Ecr17Module.h" />
    <ClInclude Include="HybridEcr17TransportWindows.hpp" />
    <ClInclude Include="NitroMsvcStdCompat.h" />
    <ClInclude Include="NitroWindowsPlatform.hpp" />
    <ClInclude Include="ReactPackageProvider.h">
      <DependentUpon>ReactPackageProvider.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="resource.h" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="targetver.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- This module (Windows-specific) -->
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Ecr17Module.cpp" />
    <ClCompile Include="HybridEcr17TransportWindows.cpp" />
    <ClCompile Include="NitroWindowsPlatform.cpp" />
    <ClCompile Include="ReactPackageProvider.cpp">
      <DependentUpon>ReactPackageProvider.idl</DependentUpon>
    </ClCompile>
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <!-- Shared C++ protocol core (same sources as android/CMakeLists.txt) -->
    <ClCompile Include="$(Ecr17PackageDir)cpp\Ecr17.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Ecr17Client\HybridEcr17Client.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Ecr17Protocol\Ecr17Protocol.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Ecr17Response\Ecr17Response.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Lcr\Lcr.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\PacketCodec\PacketCodec.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Session\Ecr17Session.cpp" />
    <ClCompile Include="$(Ecr17PackageDir)cpp\Transport\NativeTransportAdapter.cpp" />
    <!-- nitrogen-generated specs -->
    <ClCompile Include="$(Ecr17GeneratedDir)HybridEcr17ClientSpec.cpp" />
    <ClCompile Include="$(Ecr17GeneratedDir)HybridEcr17TransportSpec.cpp" />
    <!-- Nitro C++ runtime (views/RawPropsCompat.cpp is skipped: it needs Fabric renderer headers and this module has no views) -->
    <ClCompile Include="$(NitroModulesDir)cpp\core\AnyMap.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\core\ArrayBuffer.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\core\BoxedHybridObject.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\core\HybridObject.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\core\Promise.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\entrypoint\HybridNitroModulesProxy.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\entrypoint\InstallNitro.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\jsi\JSICache.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\prototype\HybridObjectPrototype.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\registry\HybridObjectRegistry.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\threading\Dispatcher.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\threading\ThreadPool.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\utils\CommonGlobals.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\utils\NitroTypeInfo.cpp" />
    <ClCompile Include="$(NitroModulesDir)cpp\utils\PropNameIDCache.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="ReactPackageProvider.idl" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Ecr17.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Ecr17.def" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ReactNativeWindowsTargets">
    <Import Project="$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets" Condition="Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets')" />
  </ImportGroup>
  <Target Name="EnsureEcr17BuildInputs" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references targets in your node_modules\react-native-windows folder. The missing file is {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props')" Text="$([System.String]::Format('$(ErrorText)', '$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.props'))" />
    <Error Condition="!Exists('$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets')" Text="$([System.String]::Format('$(ErrorText)', '$(ReactNativeWindowsDir)\PropertySheets\External\Microsoft.ReactNative.CppLib.targets'))" />
    <Error Condition="!Exists('$(NitroModulesDir)package.json')" Text="react-native-nitro-modules was not found. Install it in the app next to react-native-windows." />
    <Error Condition="!Exists('$(Ecr17GeneratedDir)HybridEcr17ClientSpec.hpp')" Text="Nitrogen output is missing ($(Ecr17GeneratedDir)). Run `npx nitrogen` in the @padosoft/react-native-ecr17 package folder." />
  </Target>
  <Target Name="GenerateNitroIncludeShims" AfterTargets="EnsureEcr17BuildInputs">
    <PropertyGroup>
      <NitroShimScript>$(Ecr17PackageDir)scripts\windows-nitro-shims.mjs</NitroShimScript>
      <NitroShimOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\include\NitroModules'))</NitroShimOutDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(NitroShimScript)')" Text="Missing Nitro Windows shim generator: $(NitroShimScript)" />
    <!-- A trailing \ in NitroModulesDir would escape the closing quote (`"path\"`), hence the trailing `.`. -->
    <Exec Command="node &quot;$(NitroShimScript)&quot; --out &quot;$(NitroShimOutDir)&quot; --nitro &quot;$(NitroModulesDir).&quot;" />
  </Target>
</Project>
