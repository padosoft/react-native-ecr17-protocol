{
	"$schema": "https://json.schemastore.org/tsconfig",
	"//": "Self-contained typecheck config for CI and clean environments. tsconfig.json extends the private @padosoft/config (typescript/compiler), which CI cannot install; this reproduces its strict options without that dependency. Keep the two in step.",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ESNext"],
		"moduleResolution": "bundler",
		"types": ["node"],
		"noEmit": true,
		"declaration": true,
		"isolatedDeclarations": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"useUnknownInCatchVariables": true
	},
	"include": ["src", "test"]
}
