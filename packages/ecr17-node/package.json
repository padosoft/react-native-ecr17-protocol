{
	"name": "@padosoft/ecr17-node",
	"version": "2.0.0",
	"description": "The ECR17 (Nexi) payment-terminal protocol for Node.js: the API of @padosoft/react-native-ecr17 on the same C++ core (@padosoft/ecr17), through a Node-API addon. Prebuilt for linux-x64, linux-arm64, darwin-arm64 and win32-x64.",
	"keywords": [
		"ecr17",
		"nexi",
		"pos",
		"payment",
		"terminal",
		"node-api",
		"napi"
	],
	"author": "padosoft",
	"license": "MIT",
	"homepage": "https://github.com/padosoft/react-native-ecr17-protocol/tree/main/packages/ecr17-node#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/padosoft/react-native-ecr17-protocol.git",
		"directory": "packages/ecr17-node"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"prebuilds",
		"node/addon.cpp",
		"node/CMakeLists.txt",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"build:node": "cmake-js compile --directory node --out build",
		"test": "bun run test:node",
		"test:node": "node --test \"test/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@padosoft/ecr17": "^2.0.0"
	},
	"devDependencies": {
		"@padosoft/config": "^1.5.0",
		"@types/node": "^26.6.4",
		"cmake-js": "^8.0.0",
		"node-addon-api": "^8.9.2",
		"tsdown": "^0.23.0"
	}
}
